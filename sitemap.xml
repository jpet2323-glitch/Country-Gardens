---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}{% unless p.noindex %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ p.url | replace: 'index.html', '' }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </url>
{%- endunless %}{% endfor %}
</urlset>
